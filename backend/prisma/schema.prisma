generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  roleId       String
  avatar       String?
  passwordHash String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role              Role               @relation(fields: [roleId], references: [id])
  courriers         Courrier[]
  courriersSupprimes Courrier[]         @relation("SuppriméPar")
  actions           AuditLog[]
  historiqueActions HistoriqueAction[]
  retraits          Retrait[]
  importLogs         ImportLog[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model Signataire {
  id        String   @id @default(cuid())
  code      String   @unique
  nom       String
  actif     Boolean  @default(true)
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courriers Courrier[]
}

model Courrier {
  id                  String    @id @default(cuid())
  numero              String    @unique
  dateEnvoi           DateTime
  destinataire        String
  objet               String
  signataire          String
  signataireId        String?
  numeroEntrant       String?
  dateArriveeEntrant  DateTime?
  nombrePages         Int?
  expediteur          String?
  dateObservation     DateTime?
  dureeTraitement     Float?
  observation         String?
  modeEnvoi           String?
  nbrRappels          Int       @default(0)
  createdById         String
  deletedAt           DateTime?
  deletedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  createdBy         User              @relation(fields: [createdById], references: [id])
  deletedBy         User?             @relation("SuppriméPar", fields: [deletedById], references: [id])
  signataireRef     Signataire?       @relation(fields: [signataireId], references: [id])
  historiqueActions HistoriqueAction[]
  retrait           Retrait?

  @@index([dateEnvoi])
  @@index([signataire])
  @@index([signataireId])
  @@index([deletedAt])
}

model HistoriqueAction {
  id              String   @id @default(cuid())
  courrierId      String
  transitionId    String?
  action          String
  commentaire     String?
  userId          String
  createdAt       DateTime @default(now())

  courrier           Courrier   @relation(fields: [courrierId], references: [id], onDelete: Cascade)
  user               User       @relation(fields: [userId], references: [id])

  @@index([courrierId])
  @@index([createdAt])
  @@index([userId])
}

model Retrait {
  id            String   @id @default(cuid())
  courrierId    String   @unique
  nomRetraitant String
  telephone     String?
  observation   String?
  retireParId   String
  dateRetrait   DateTime @default(now())

  courrier  Courrier @relation(fields: [courrierId], references: [id])
  retirePar User     @relation(fields: [retireParId], references: [id])
}

model AuditLog {
  id             String   @id @default(cuid())
  action         String
  entity         String
  entityId       String
  details        String?
  ancienneValeur String?
  nouvelleValeur String?
  ip             String?
  userId         String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

model Parametre {
  id     String @id @default(cuid())
  cle    String @unique
  valeur String
}

model SituationLog {
  id            String   @id @default(cuid())
  type          String
  situationType String   @default("Générale")
  periode       String
  filtres       String
  params        String   @default("")
  nbCourriers   Int
  taille        Int      @default(0)
  userNom       String
  userId        String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model ImportLog {
  id         String   @id @default(cuid())
  fileName   String
  userId     String
  userName   String
  nbLignes   Int
  nbImportes Int
  nbIgnores  Int
  nbMaj      Int
  nbErreurs  Int
  dureeMs    Int
  resultat   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([createdAt])
}
